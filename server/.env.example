APP_ENV=demo
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
APP_PUBLIC_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost
ORDER_AGREEMENT_REQUIRED=true
ORDER_AGREEMENT_VERSION=draft-2026-10-24-v1
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ENABLED_METHODS=
CARD_DEMO_ENABLED=false
WALLET_DEMO_ENABLED=false
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RESET_TOKEN_PEPPER=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cookie Fluffs
# Optional: where Contact Us messages are emailed (Reply-To is the customer). Leave empty to only show them in the admin.
CONTACT_INBOX_EMAIL=
GOOGLE_AUTH_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_AUTH_NONCE_PEPPER=
# Identity verification (Phase 2). The challenge engine works with just the pepper (used by
# tests); real code delivery stays off unless VERIFICATION_DELIVERY_ENABLED=true with a verified
# Brevo sender (reuses BREVO_API_KEY / BREVO_SENDER_EMAIL / BREVO_SENDER_NAME above).
VERIFICATION_DELIVERY_ENABLED=false
VERIFICATION_CODE_PEPPER=
FULFILLMENT_DELIVERY_ENABLED=false
FULFILLMENT_DELIVERY_CITY_CODES=
FULFILLMENT_PICKUP_ENABLED=false
FULFILLMENT_PICKUP_LOCATION=
FULFILLMENT_PICKUP_HOURS=
